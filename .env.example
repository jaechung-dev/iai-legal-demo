# OpenAI (embeddings + chat LLM)
OPENAI_API_KEY=sk-...

# Anthropic (optional — set CHAT_MODEL=claude-haiku-4-5 to use instead)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase / PostgreSQL (psycopg2 DSN format)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Models
EMBED_MODEL=text-embedding-3-small
# Chat LLM — change this one line to switch provider:
#   gpt-4o-mini       → OpenAI  (~$0.15/1M, cheapest)
#   claude-haiku-4-5  → Anthropic (~$1/1M)
CHAT_MODEL=gpt-4o-mini

# Auth
JWT_SECRET=change-me-in-production
SOJUNG_PASSWORD=demo1234
ADMIN_PASSWORD=admin1234

# MCP OAuth (optional)
MCP_KEY=lrag-demo
MCP_API_KEYS=[]
