# ── Backend ───────────────────────────────────────────────────────────────────

# OpenAI (embeddings + chat LLM)
OPENAI_API_KEY=sk-...

# Anthropic (optional — set CHAT_MODEL=claude-haiku-4-5 to use instead)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase / PostgreSQL (psycopg2 DSN format)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Models
EMBED_MODEL=text-embedding-3-small
# Chat LLM — change this one line to switch provider:
#   gpt-4o-mini       → OpenAI  (~$0.15/1M, cheapest)
#   claude-haiku-4-5  → Anthropic (~$1/1M)
CHAT_MODEL=gpt-4o-mini

# Auth (all three are required — app will not start without them)
JWT_SECRET=                        # generate: openssl rand -hex 32
DEMO_PASSWORD=                     # guest account password
ADMIN_PASSWORD=                    # admin account password

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs (backend)
PORT=20000
BACKEND_URL=https://api.probonoai.com.au
FRONTEND_URL=https://www.probonoai.com.au
FROM_EMAIL=noreply@probonoai.com.au

# MCP server
MCP_PORT=20002
MCP_KEY=

# ── Frontend (NEXT_PUBLIC_* — bundled into the client) ────────────────────────

NEXT_PUBLIC_API_URL=https://api.probonoai.com.au
NEXT_PUBLIC_APP_URL=https://www.probonoai.com.au
NEXT_PUBLIC_MCP_URL=https://api.probonoai.com.au/mcp
NEXT_PUBLIC_APP_NAME=ProBono AI
NEXT_PUBLIC_APP_DOMAIN=probonoai.com.au
NEXT_PUBLIC_FEATURED_CASE=R v Nguyen [2025]

# ── Testing ───────────────────────────────────────────────────────────────────

PLAYWRIGHT_BASE_URL=http://localhost:20001
