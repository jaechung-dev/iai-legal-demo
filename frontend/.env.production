# Public build-time config baked into the production bundle by Vite (loadEnv).
# These are public URLs — not secrets — so they live in the repo to keep local
# and CI builds identical. Override locally with .env.local (gitignored).
NEXT_PUBLIC_API_URL=https://api.probonoai.com.au
NEXT_PUBLIC_APP_URL=https://www.probonoai.com.au
NEXT_PUBLIC_MCP_URL=https://api.probonoai.com.au/mcp
NEXT_PUBLIC_APP_NAME=ProBono AI
NEXT_PUBLIC_APP_DOMAIN=probonoai.com.au
